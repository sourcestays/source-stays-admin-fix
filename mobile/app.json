{
  "expo": {
    "name": "Source Stays",
    "slug": "source-stays",
    "scheme": "sourcestays",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sourcestays.app"
    },
    "android": {
      "package": "com.sourcestays.app",
      "adaptiveIcon": {
        "backgroundColor": "#123D2B"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
